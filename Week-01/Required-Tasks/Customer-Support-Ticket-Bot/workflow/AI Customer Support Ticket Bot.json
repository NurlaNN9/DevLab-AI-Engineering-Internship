        "method": "POST",
        "url": "http://host.docker.internal:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gemma4:e2b\",\n  \"stream\": false,\n  \"format\": \"json\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a customer support intent classifier. Classify the user's message into exactly one of these categories: billing, technical, general. Return ONLY valid JSON in exactly this structure: {\\\"category\\\":\\\"billing\\\"}. The category value must be billing, technical, or general. Do not include explanations or any other text.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json.message.text}}\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
