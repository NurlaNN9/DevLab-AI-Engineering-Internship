        -1728,
        -240
      ],
      "id": "1eaf602a-c5c7-43e2-a61c-211f3e6c476d",
      "name": "AI Intent Classifier",
      "retryOnFail": true,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  try {\n    const parsed = JSON.parse(item.json.message.content);\n    const allowed = [\"billing\", \"technical\", \"general\"];\n\n    item.json.category = allowed.includes(parsed.category)\n      ? parsed.category\n      : \"fallback\";\n  } catch (error) {\n    item.json.category = \"fallback\";\n  }\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
