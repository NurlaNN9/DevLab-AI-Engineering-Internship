    {
      "parameters": {
        "content": "MESSAGE ROUTING\n\nRoutes incoming Telegram messages:\n• /yes → Positive confirmation\n• /no → Negative confirmation\n• /addfaq → Admin FAQ creation\n• Other messages → FAQ similarity matching",
        "height": 224,
        "width": 304,
        "color": 7
