    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text = $('Telegram Trigger').first().json.message.text;\n\n// Remove the /addfaq command\nconst content = text.replace(/^\\/addfaq\\s*/i, '').trim();\n\n// Split question and answer using |\nconst parts = content.split('|');\n\nif (parts.length < 2) {\n  return {\n    json: {\n      valid: false,\n      error: 'Invalid format'\n    }\n  };\n}\n\nconst question = parts[0].trim();\nconst answer = parts.slice(1).join('|').trim();\n\nif (!question || !answer) {\n  return {\n    json: {\n      valid: false,\n      error: 'Question or answer is empty'\n    }\n  };\n}\n\nreturn {\n  json: {\n    valid: true,\n    question,\n    answer\n  }\n};"
      },
